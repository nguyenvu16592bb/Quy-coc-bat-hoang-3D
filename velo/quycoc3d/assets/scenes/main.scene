# Quỷ Cốc Bát Hoang 3D — the floating peak of Quỷ Cốc Sơn, the hero (FBX than_dieu),
# and the full wuxia HUD. Design reference: qu_c_c_b_t_hoang_3d.html.
node Main {
  Environment3D { sky = [22, 50, 56]  ground = [29, 43, 36]  ambient = 0.62  fog_color = [27, 59, 66]  fog_density = 0.02 }
  node Sun {
    DirectionalLight3D { direction = [-0.45, -1, -0.4]  color = [255, 241, 214]  intensity = 1.2 }
  }
  node Camera {
    Transform3D { position = [30, 26, 30] }
    Camera3D { fov = 34  near = 0.5  far = 400 }
    FollowIsoCamera { }
  }
  node World {
    WorldBuilder { }
    WaveSpawner { }
    node Platform {
      Transform3D { position = [0, -1.1, 0]  scale = [50, 2.2, 50] }
      MeshRenderer3D { mesh = "cylinder"  color = [37, 56, 52]  pattern = "noise" }
    }
    node UnderRock {
      Transform3D { position = [0, -14, 0]  rotation = [180, 0, 0]  scale = [47, 24, 47] }
      MeshRenderer3D { mesh = "cone"  color = [38, 53, 56]  pattern = "noise" }
    }
    node Plaza {
      Transform3D { position = [0, 0.02, 0]  scale = [18, 1, 18] }
      MeshRenderer3D { mesh = "grid"  grid_cells = 6  color = [66, 80, 82]  pattern = "tiles" }
    }
    node Hero {
      Transform3D { position = [0, 0, 6] }
      SkinnedModel3D { model = @asset("a3d0f8b1")  rim = 0.25 }
      HeroController { }
      PlayerCombat { }
      node Sword {
        Transform3D { rotation = [-70, 0, 0] }
        BoneAttach3D { bone = "RightHand"  offset = [0, -0.1, 0.1] }
        node Blade {
          Transform3D { position = [0, -0.35, 0]  scale = [0.32, 1.65, 0.07] }
          MeshRenderer3D { mesh = "cube"  color = [118, 130, 135]  rim = 0.3 }
        }
        node Edge {
          Transform3D { position = [0, -0.32, 0]  scale = [0.1, 1.5, 0.09] }
          MeshRenderer3D { mesh = "cube"  color = [186, 196, 201] }
        }
        node Tip {
          Transform3D { position = [0, -1.38, 0]  rotation = [180, 45, 0]  scale = [0.45, 0.42, 0.45] }
          MeshRenderer3D { mesh = "cone"  color = [186, 196, 201] }
        }
        node Guard {
          Transform3D { position = [0, 0.5, 0]  scale = [0.56, 0.14, 0.16] }
          MeshRenderer3D { mesh = "cube"  color = [118, 130, 135] }
        }
        node Hilt {
          Transform3D { position = [0, 0.82, 0]  scale = [0.13, 0.52, 0.13] }
          MeshRenderer3D { mesh = "cylinder"  color = [92, 54, 41] }
        }
        node Pommel {
          Transform3D { position = [0, 1.1, 0]  scale = [0.19, 0.19, 0.19] }
          MeshRenderer3D { mesh = "sphere"  color = [118, 130, 135] }
        }
      }
      node Dust {
        Particles3D { preset = "dust" }
      }
      node Halo {
        Transform3D { position = [0, 0.05, 0]  scale = [1.5, 1.5, 1.5] }
        Spin3D { speed = [0, 90, 0] }
        MeshRenderer3D { mesh = "ring"  color = [103, 65, 217, 140]  blend = "additive"  unlit = true }
      }
      node Halo2 {
        Transform3D { position = [0, 0.07, 0]  scale = [1.1, 1.1, 1.1] }
        Spin3D { speed = [0, -140, 0] }
        MeshRenderer3D { mesh = "ring"  color = [177, 151, 252, 170]  blend = "additive"  unlit = true }
      }
      node Halo3 {
        Transform3D { position = [0, 0.09, 0]  scale = [0.7, 0.7, 0.7] }
        Spin3D { speed = [0, 200, 0] }
        MeshRenderer3D { mesh = "ring"  color = [208, 191, 255, 200]  blend = "additive"  unlit = true }
      }
    }
  }

  # ---------------- HUD ----------------
  node HUD {
    Canvas { }
    HUDSync { }
    WorldMapUI { }
    BattleDirector { }
    BattlePanelUI { }
    PvpPanelUI { }
    TownPanelUI { }
    node Floats { }
    node TopLeft {
